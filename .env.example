# Copy this file to .env and adjust it. .env is read by:
#   - ./gradlew bootRun and the jar, from the folder they are started in
#   - docker compose, from the folder of docker-compose.yml
# .env is not committed. Keep real secrets there, never in this file.
# For plain "docker run", pass the values with -e instead of --env-file.

# HMAC secret for the tokens, at least 32 characters. If it is empty or not set,
# a random one is generated at startup and tokens stop working after a restart.
# This value is for local development only; generate your own with: openssl rand -base64 48
NORDIA_JWT_SECRET=dev-only-secret-replace-me-0123456789abcdef

# Where revoked tokens are remembered: memory or redis.
# docker compose sets redis for the app by itself.
NORDIA_SECURITY_TOKEN_BLACKLIST=memory

# Redis host, only used when the blacklist is redis.
SPRING_DATA_REDIS_HOST=localhost

# Path of the SQLite file (default: nordia.db in the working directory).
# NORDIA_DB_PATH=nordia.db
